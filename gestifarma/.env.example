# Copiar a .env y completar. El .env NO se sube al repositorio.

# Acceso a la app (obligatorio fuera de una prueba local)
GESTIFARMA_USUARIO=backoffice
GESTIFARMA_CLAVE=cambiar-esta-clave

# Clave de la API de Claude (platform.claude.com) para leer las recetas con IA.
# Vacía: las recetas se guardan igual y los datos se cargan a mano.
ANTHROPIC_API_KEY=

# Opcionales
# GESTIFARMA_MODELO=claude-opus-5-5
# GESTIFARMA_ESFUERZO=medium
# GESTIFARMA_DATABASE_URL=postgresql+psycopg://usuario:clave@servidor:5432/gestifarma

# Docker: por defecto la app solo escucha en esta máquina. 0.0.0.0 la abre a la red local (sin HTTPS).
# GESTIFARMA_BIND=0.0.0.0
# Docker con HTTPS (perfil "https"): dominio que apunta a este servidor
# GESTIFARMA_DOMINIO=gestifarma.ejemplo.com.ar

# Robot que descarga reportes de un portal (gestifarma traer)
# GESTIFARMA_PORTAL_USUARIO=
# GESTIFARMA_PORTAL_CLAVE=
