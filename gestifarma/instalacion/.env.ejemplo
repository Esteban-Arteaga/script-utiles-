# Configuración de Gestifarma en el servidor de la farmacia. ./gestifarma.sh instalar lo copia a .env y
# genera las claves vacías. El .env tiene secretos: no compartirlo, no subirlo al repositorio.

# --- Dirección y certificado ------------------------------------------------------------------
# Dirección con la que entran los usuarios: un registro DNS que apunte a la IP de este servidor.
GESTIFARMA_DOMINIO=
# Cómo se obtiene el certificado HTTPS:
#   red-local  servidor en la farmacia, sin abrir puertos a internet (valida por DNS en Cloudflare)
#   publico    servidor en la nube con IP pública (valida por HTTP en el puerto 80)
#   interno    solo para pruebas (los navegadores muestran una advertencia)
GESTIFARMA_HTTPS=red-local
# Token de Cloudflare con permiso Zone > DNS > Edit, solo sobre el dominio de la farmacia (modo red-local).
CLOUDFLARE_API_TOKEN=
# IP del servidor en la que se atiende (vacío = todas sus IP).
GESTIFARMA_IP=

# --- Acceso a la app ----------------------------------------------------------------------------
GESTIFARMA_USUARIO=backoffice
GESTIFARMA_CLAVE=

# --- Versión ------------------------------------------------------------------------------------
# Imagen publicada por Gestifarma (por ejemplo ghcr.io/organizacion/gestifarma).
# Vacío: la imagen se construye desde este repositorio.
GESTIFARMA_IMAGEN=
# Versión instalada: la escriben instalar y actualizar.
GESTIFARMA_VERSION=

# --- Base de datos ------------------------------------------------------------------------------
POSTGRES_PASSWORD=

# --- Respaldos ----------------------------------------------------------------------------------
# Clave de cifrado de los respaldos. Imprimirla y guardarla en un sobre cerrado en la farmacia:
# sin ella los respaldos no se pueden restaurar.
RESTIC_PASSWORD=
# Carpeta donde está montado el disco externo de respaldo (por ejemplo /mnt/respaldo).
RESPALDO_DISCO=
# Copia fuera del local (opcional), en formato de restic. Por ejemplo:
#   s3:s3.sa-east-1.amazonaws.com/respaldos-farmacia/gestifarma   (con las claves de AWS de abajo)
#   rest:https://usuario:clave@respaldos.otra-sucursal.com.ar:8000/gestifarma
RESPALDO_REMOTO=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Horario del respaldo diario (formato de cron, hora del servidor).
RESPALDO_HORARIO="30 23 * * *"
# Monitor de Gestifarma (opcional): solo recibe si el respaldo salió bien o mal.
MONITOR_URL=

# --- Lectura de recetas ---------------------------------------------------------------------------
# local: sin IA, en este servidor. La IA a pedido queda apagada: ninguna imagen sale del local.
GESTIFARMA_LECTOR=local
GESTIFARMA_OCR=tesseract
GESTIFARMA_LECTURA_IA=no
ANTHROPIC_API_KEY=
